## Ignore Visual Studio temporary files, build results, and user-specific settings

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Re]leases/
x64/
x86/
build/
bin/
obj/

# Visual Studio cache, preferences, and private settings
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates

# Mono Auto Generated Files
mono_crash.*

# Windows image analyses cache
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# SQL Server files
*.mdf
*.ldf
*.ndf

# SQLite database files
*.db
*.db-journal
*.sqlite
*.sqlite3

# Log files
*.log
image_errors.log
